{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://localhost:5001"
      }
    }
  },
  "ConnectionStrings": {
    "Financeiro": "Server=(localdb)\\MSSQLLocalDB;Database=CartsysFinanceiro;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Database": {
    "AplicarMigracoesAoIniciar": true
  },
  "Seguranca": {
    "ApiKeys": {
      "ErpVendas": "troque-esta-chave-financeiro",
      "Operador": "troque-esta-chave-operador"
    }
  },
  "ErpVendas": {
    "BaseUrl": "http://localhost:9000/api/v1/",
    "ApiKey": "troque-esta-chave-vendas",
    "TimeoutSegundos": 10
  },
  "Outbox": {
    "Habilitado": true,
    "IntervaloSegundos": 15,
    "LoteMaximo": 20
  }
}
